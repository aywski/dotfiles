{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Jellybeans OLED",
  "author": "reimu",
  "themes": [
    {
      "name": "Jellybeans OLED",
      "appearance": "dark",
      "style": {
        "background": "#090909",
        "foreground": "#e8e8d3",
        "border": "#3b3b3b",
        "border.variant": "#1d1d1d",
        "border.focused": "#597bc5",
        "border.selected": "#597bc5",
        "border.disabled": "#1d1d1d",
        "border.transparent": "#09090900",

        "elevated_surface.background": "#131313",
        "surface.background": "#131313",

        "element.background": "#131313",
        "element.hover": "#1d1d1d",
        "element.active": "#252525",
        "element.selected": "#263a52",
        "element.disabled": "#131313",

        "ghost_element.background": "#09090900",
        "ghost_element.hover": "#131313",
        "ghost_element.active": "#1d1d1d",
        "ghost_element.selected": "#263a52",
        "ghost_element.disabled": "#131313",

        "drop_target.background": "#597bc520",

        "text": "#e8e8d3",
        "text.muted": "#888888",
        "text.placeholder": "#888888",
        "text.disabled": "#555555",
        "text.accent": "#71b9f8",

        "icon": "#adadad",
        "icon.muted": "#888888",
        "icon.disabled": "#555555",
        "icon.placeholder": "#888888",
        "icon.accent": "#71b9f8",

        "status_bar.background": "#131313",
        "title_bar.background": "#090909",
        "title_bar.inactive_background": "#090909",
        "toolbar.background": "#090909",
        "tab_bar.background": "#090909",
        "tab.inactive_background": "#131313",
        "tab.active_background": "#1d1d1d",

        "search.match_background": "#d8ad4c30",

        "panel.background": "#090909",
        "panel.focused_border": "#597bc5",
        "pane.focused_border": "#597bc5",
        "pane.group_border": "#3b3b3b",

        "scrollbar_thumb.background": "#3b3b3b",
