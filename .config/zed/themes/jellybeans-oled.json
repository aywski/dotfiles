        "ignored.background": "#090909",
        "ignored.border": "#3b3b3b",
        "info": "#597bc5",
        "info.background": "#597bc520",
        "info.border": "#597bc5",
        "modified": "#d8ad4c",
        "modified.background": "#d8ad4c20",
        "modified.border": "#d8ad4c",
        "predictive": "#888888",
        "predictive.background": "#090909",
        "predictive.border": "#3b3b3b",
        "renamed": "#71b9f8",
        "renamed.background": "#71b9f820",
        "renamed.border": "#71b9f8",
        "success": "#99ad6a",
        "success.background": "#11331120",
        "success.border": "#99ad6a",
        "unreachable": "#888888",
        "unreachable.background": "#090909",
        "unreachable.border": "#3b3b3b",
        "warning": "#d8ad4c",
        "warning.background": "#d8ad4c20",
        "warning.border": "#d8ad4c",

        "players": [
          {
            "cursor": "#fad07a",
            "background": "#fad07a",
            "selection": "#263a52"
          },
          {
            "cursor": "#71b9f8",
            "background": "#71b9f8",
            "selection": "#1a2a3a"
          },
          {
            "cursor": "#99ad6a",
            "background": "#99ad6a",
            "selection": "#1a2a1a"
          },
          {
            "cursor": "#cf6a4c",
            "background": "#cf6a4c",
            "selection": "#2a1a1a"
          }
        ],

        "syntax": {
          "attribute": { "color": "#71b9f8" },
          "boolean": { "color": "#cf6a4c" },
          "character": { "color": "#99ad6a" },
          "comment": { "color": "#888888", "font_style": "italic" },
          "comment.doc": { "color": "#888888", "font_style": "italic" },
          "constant": { "color": "#e07b54" },
          "constant.builtin": { "color": "#e07b54" },
          "constructor": { "color": "#fad07a" },
          "embedded": { "color": "#e8e8d3" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#71b9f8" },
          "function": { "color": "#fad07a" },
          "function.builtin": { "color": "#fad07a" },
          "function.definition": { "color": "#fad07a" },
          "function.method": { "color": "#fad07a" },
          "function.method.builtin": { "color": "#fad07a" },
          "function.special.definition": { "color": "#fad07a" },
          "keyword": { "color": "#8197bf" },
          "keyword.operator": { "color": "#8197bf" },
          "keyword.type": { "color": "#71b9f8" },
          "label": { "color": "#8197bf" },
          "link_text": { "color": "#71b9f8", "font_style": "italic" },
          "link_uri": { "color": "#88ccff" },
          "markup.bold": { "color": "#e8e8d3", "font_weight": 700 },
          "markup.heading": { "color": "#fad07a", "font_weight": 700 },
          "markup.heading.marker": { "color": "#888888" },
          "markup.italic": { "color": "#e8e8d3", "font_style": "italic" },
          "markup.list": { "color": "#cf6a4c" },
          "markup.list.checked": { "color": "#888888" },
          "markup.list.unchecked": { "color": "#adadad" },
          "markup.quote": { "color": "#888888", "font_style": "italic" },
          "markup.raw": { "color": "#99ad6a" },
          "markup.raw.block": { "color": "#99ad6a" },
          "markup.raw.inline": { "color": "#99ad6a" },
          "markup.strikethrough": { "font_style": "italic" },
          "module": { "color": "#71b9f8" },
          "namespace": { "color": "#71b9f8" },
          "number": { "color": "#cf6a4c" },
          "operator": { "color": "#adadad" },
          "property": { "color": "#e8e8d3" },
          "punctuation": { "color": "#adadad" },
          "punctuation.bracket": { "color": "#adadad" },
          "punctuation.delimiter": { "color": "#adadad" },
          "punctuation.list_marker": { "color": "#cf6a4c" },
          "punctuation.special": { "color": "#c6b6ee" },
          "string": { "color": "#99ad6a" },
          "string.escape": { "color": "#c6b6ee" },
          "string.regex": { "color": "#c6b6ee" },
          "string.special": { "color": "#c6b6ee" },
          "string.special.symbol": { "color": "#c6b6ee" },
          "tag": { "color": "#8197bf" },
          "text.literal": { "color": "#99ad6a" },
          "title": { "color": "#fad07a", "font_weight": 700 },
          "type": { "color": "#71b9f8" },
          "type.builtin": { "color": "#71b9f8" },
          "type.super": { "color": "#71b9f8" },
          "variable": { "color": "#e8e8d3" },
          "variable.member": { "color": "#e8e8d3" },
          "variable.parameter": { "color": "#e8e8d3" },
          "variable.special": { "color": "#c6b6ee" },
          "variant": { "color": "#71b9f8" }
